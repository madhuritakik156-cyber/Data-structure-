#include <iostream>
using namespace std;

int main()
{
   int book[5];
   int searchId;
   
    cout <<"Enter 5 book id\n";
    for (int i = 0; i < 5; i++)
    {
        cin >> book[i];
    }

    cout << "\nEnter Book ID to search: ";
    cin >> searchId;

    bool found = false;

    for (int i =0; i<5; i++)
        {
        if (book[i] == searchId)
        {
            cout << "Book found";
            found = true;
            break;
        }
  }  

if (!found)
{
    cout << "Book not found";
}
    return 0;
}
  
